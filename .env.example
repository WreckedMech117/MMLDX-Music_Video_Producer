MVP_APP_HOST=127.0.0.1
MVP_APP_PORT=8765
MVP_COMFY_URL=http://127.0.0.1:8188
MVP_COMFY_ROOT=J:\Hermes-Remote\comfyui\ComfyUI_windows_portable\ComfyUI
MVP_DATA_ROOT=F:\MusicVideoProducer\data
MVP_MAX_UPLOAD_BYTES=2147483648

# OpenAI-compatible LLM endpoint. Leave blank to disable Director chat honestly.
# Examples: http://127.0.0.1:1234/v1 (LM Studio), http://127.0.0.1:11434/v1 (Ollama)
MVP_LLM_BASE_URL=http://127.0.0.1:1234/v1
MVP_LLM_MODEL=huihui-qwythos-9b-claude-mythos-5-1m-abliterated
MVP_LLM_API_KEY=

# Release the language model's VRAM before each ComfyUI submission. ON by default; these
# lines are documentation, not a change — omitting them leaves the eject enabled.
# It never blocks a render: no host configured, nothing loaded, or no `lms` CLI all mean
# "skip and submit". A failure is logged once and the render goes ahead regardless.
# Set to false if you would rather keep the model resident between renders.
#MVP_LLM_EJECT_BEFORE_RENDER=true
# Path to LM Studio's `lms` executable. Blank means look on PATH, then ~/.lmstudio/bin.
#MVP_LLM_EJECT_EXECUTABLE=
# Seconds a render may wait for the eject before abandoning it.
#MVP_LLM_EJECT_TIMEOUT=20
